---
import { copy, type Language } from "../data/content";
const { lang } = Astro.props as { lang: Language };
const t = copy[lang];
---

<figure class="demo real-media">
  <div class="device-stage">
    <div class="device-frame">
      <div class="device-screen">
        <video
          id="hero-video"
          controls
          muted
          loop
          playsinline
          preload="metadata"
          width="720"
          height="1558"
          poster="/media/cardpress-17e-poster.jpg"
          aria-label={t.demoNote}
        >
          <source src="/media/cardpress-17e-hero.mp4" type="video/mp4" />
          {(["zh", "en"] as const).map((language) => (
            <track
              kind="captions"
              src={`/media/cardpress-17e-hero.${language}.vtt`}
              srclang={language}
              label={language === "zh" ? "简体中文" : "English"}
              default={language === lang}
            />
          ))}
        </video>
      </div>
    </div>
  </div>
</figure>
<script>
  const hero = document.querySelector<HTMLVideoElement>("#hero-video");
  if (hero) {
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    const updatePlayback = () => {
      hero.autoplay = !motion.matches;
      if (motion.matches) hero.pause();
      else {
        // Native controls remain available if the browser blocks autoplay.
        void hero.play().catch(() => {});
      }
    };
    updatePlayback();
    motion.addEventListener("change", updatePlayback);
  }
</script>
