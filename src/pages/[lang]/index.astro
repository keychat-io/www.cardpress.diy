---
import Layout from "../../layouts/Layout.astro";
import Gallery from "../../components/Gallery.astro";
import Media from "../../components/Media.astro";
import { languages, copy, type Language } from "../../data/content";
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Language;
const t = copy[lang];
---

<Layout lang={lang} title={t.hero} description={t.intro}>
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="dot"></span> {t.tagline}
      </p>
      <h1>
        {t.heroLead}
        <span class="hero-accent">{t.heroAccent}</span>
      </h1>
      <p class="lede">{t.intro}</p>
      <div class="actions">
        <a class="button primary" href="#download">
          {t.ios}
        </a>
        <a class="button secondary" href="#download">
          {t.android}
        </a>
      </div>
      <a class="text-link" href="#scenarios">
        {t.explore} <span aria-hidden="true">↓</span>
      </a>
    </div>
    <Media lang={lang} />
    <div class="hero-orbit" aria-hidden="true"></div>
  </section>
  <section class="section wrap" id="start">
    <div class="card-overview">
      <div>
        <p class="eyebrow">
          01 / {lang === "zh" ? "认识卡片" : "Meet the cards"}
        </p>
        <h2>{t.cardsTitle}</h2>
        <p class="card-intro">{t.cardsIntro}</p>
        <dl class="card-layers">
          {t.cardLayers.map(([label, value, description]) => (
            <div>
              <dt>{label}</dt>
              <dd>
                <strong>{value}</strong>
                <p>{description}</p>
              </dd>
            </div>
          ))}
        </dl>
      </div>
      <div>
        <figure class="card-photo">
          <img
            src="/media/card-example.png"
            width="1200"
            height="900"
            alt={t.photoAlt}
            loading="lazy"
          />
        </figure>
        <div class="card-models">
          <h3>{t.cardModelsTitle}</h3>
          <p>{t.cardModelsIntro}</p>
          <div class="card-model-list">
            {t.cardModels.map(([model, os]) => (
              <div>
                <strong>{model}</strong>
                <span>{os}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
    <div class="card-choice">
      <h3>{t.cardChoiceTitle}</h3>
      <p>{t.cardChoiceBody}</p>
    </div>
  </section>
  <section class="app-section section" id="app">
    <div class="wrap">
      <div class="section-heading centered">
        <p class="eyebrow">02 / {t.nav[1]}</p>
        <h2>{t.screensTitle}</h2>
        <p>{t.screensIntro}</p>
      </div>
      <Gallery
        lang={lang}
        screenshots={[
          "cards-en.png",
          "card-detail-en.png",
          "applets-en.png",
        ].map((file, index) => ({
          src: `/media/${file}`,
          alt: `${t.screens[index]} · ${t.interfaceLanguage}`,
          width: 1170,
          height: 2532,
        }))}
      />
    </div>
  </section>
  <section class="section wrap" id="scenarios">
    <div class="section-heading">
      <p class="eyebrow">03 / {t.nav[0]}</p>
      <h2>{t.scenesTitle}</h2>
      <p>{t.scenesIntro}</p>
    </div>
    <div class="scenarios">
      {t.scenarios.map((s, i) => (
        <article class={`scenario scene-${i}`}>
          <div class="scene-art" aria-hidden="true">
            <span class="scene-symbol">{s.symbol}</span>
            <span class="scene-token">{s.visual}</span>
          </div>
          <h3>{s.title}</h3>
          <p class="benefit">{s.benefit}</p>
          <p class="support">{s.detail}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="download section" id="download">
    <div class="wrap">
      <div class="section-heading centered">
        <p class="eyebrow">04 / {t.nav[3]}</p>
        <h2>{t.downloadTitle}</h2>
        <p>{t.downloadIntro}</p>
      </div>
      <div class="download-options">
        <button class="button download-button" type="button" disabled>
          {t.ios}
        </button>
        <button class="button download-button" type="button" disabled>
          {t.android}
        </button>
      </div>
      <div class="faq">
        <h3>{t.faqTitle}</h3>
        {t.faq.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
