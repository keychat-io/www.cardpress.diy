---
import Layout from '../../../layouts/Layout.astro';
import {languages,copy,articles,type Language} from '../../../data/content';
export function getStaticPaths(){return languages.flatMap(lang=>articles.map(article=>({params:{lang,slug:article.slug},props:{article}})));}
const {article}=Astro.props;const lang=Astro.params.lang as Language;const t=copy[lang];const a=article[lang];
---
<Layout lang={lang} title={a.title} description={a.description} path={`learn/${article.slug}/`}><article class="reading"><a class="text-link" href={`/${lang}/learn/`}>← {t.back}</a><p class="eyebrow">Learn / 0{articles.findIndex(item=>item.slug===article.slug)+1}</p><h1>{a.title}</h1><p class="lede">{a.description}</p>{a.sections.map(([title,body])=><section><h2>{title}</h2><p>{body}</p></section>)}<aside class="sources"><h2>{t.sources}</h2><ul>{article.sources.map(([label,url])=><li><a href={url}>{label} ↗</a></li>)}</ul></aside><a class="button primary" href={`/${lang}/#download`}>{t.nav[3]} ↗</a></article></Layout>
