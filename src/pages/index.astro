---
import Layout from "../layouts/Layout.astro";
---

<Layout
  lang="en"
  title="One card. More possibilities."
  description="Choose your language to explore CardPress."
>
  <section class="reading">
    <h1>CardPress</h1>
    <p class="lede">
      One card. More possibilities.
      <br />
      让一张卡，成为你的数字钥匙。
    </p>
    <div class="actions">
      <a class="button primary" href="/zh/" lang="zh-Hans">
        简体中文
      </a>
      <a class="button secondary" href="/en/" lang="en">
        English
      </a>
    </div>
  </section>
</Layout>
